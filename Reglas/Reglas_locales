mitre_custom_rules
<group name="mitre_custom,">

  <!-- ========================================================= -->
  <!-- CORRELACION TEMPORAL POR USUARIO -->
  <!-- ========================================================= -->

  <!-- MITRE T1003 — Lectura /etc/shadow (credential dumping) -->
  <rule id="100300" level="12">
    <if_group>audit_command</if_group>
    <field name="audit.key">shadow_read</field>
    <field name="audit.exe" negate="yes">/var/ossec/bin/wazuh-modulesd</field>
    <description>Auditd: Lectura de /etc/shadow detectada - posible credential dumping</description>
    <mitre>
      <id>T1003</id>
    </mitre>
    <group>audit,credential_access,</group>
  </rule>

  <!-- MITRE T1048 — Ejecución herramienta exfiltración -->
  <rule id="100301" level="11">
    <if_group>audit_command</if_group>
    <field name="audit.key">exfil_tool</field>
    <description>Auditd: Ejecución de herramienta de exfiltración - $(audit.command)</description>
    <mitre>
      <id>T1048</id>
    </mitre>
    <group>audit,exfiltration,</group>
  </rule>

  <!-- MITRE T1005 — Lectura masiva /home -->
  <rule id="100302" level="10">
    <if_group>audit_command</if_group>
    <field name="audit.key">home_read</field>
    <description>Auditd: Acceso a directorio /home - posible recopilación de datos</description>
    <mitre>
      <id>T1005</id>
    </mitre>
    <group>audit,collection,</group>
  </rule>

  <!-- ========================================================= -->
  <!-- REGLAS DE CORRELACIÓN -->
  <!-- ========================================================= -->

  <!-- Password spraying -->
  <rule id="100200" level="12" frequency="5" timeframe="60">
    <if_matched_sid>5503</if_matched_sid>
    <same_source_ip />
    <description>MITRE T1110.003 - Password spraying: misma IP multiples usuarios</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
  </rule>

  <!-- Escalada privilegios repetida -->
  <rule id="100203" level="13" frequency="3" timeframe="300">
    <if_matched_sid>5402</if_matched_sid>
    <same_field>data.srcuser</same_field>
    <description>MITRE T1548 - Escalada privilegios repetida mismo usuario en 5min</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>

  <!-- FIM masivo -->
  <rule id="100204" level="13" frequency="5" timeframe="120">
    <if_matched_sid>100100</if_matched_sid>
    <description>MITRE T1565 - Modificacion masiva archivos criticos en 2min</description>
    <mitre>
      <id>T1565</id>
    </mitre>
  </rule>

  <!-- ========================================================= -->
  <!-- REGLAS MITRE -->
  <!-- ========================================================= -->
  <!-- MITRE T1046 - Port scan detectado por frecuencia de conexiones rechazadas -->

  <!-- Brute Force -->
  <rule id="100001" level="10">
    <if_matched_sid>5503</if_matched_sid>
    <description>MITRE T1110 - Brute Force: Multiple authentication failures</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- SSH Remote Login -->
  <rule id="100002" level="10">
    <if_matched_sid>5715</if_matched_sid>
    <description>MITRE T1021.004 - SSH: Remote login attempt detected</description>
    <mitre>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <!-- Sudo Execution -->
  <rule id="100003" level="8">
    <if_matched_sid>5407</if_matched_sid>
    <description>MITRE T1078 - Valid Accounts: Sudo execution detected</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- Credential Dumping -->
  <rule id="100004" level="12">
    <if_sid>5715</if_sid>
    <match>/etc/shadow</match>
    <description>MITRE T1003 - Credential Dumping: Access to /etc/shadow</description>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <!-- Script Execution -->
  <rule id="100005" level="8">
    <if_sid>5400</if_sid>
    <match>bash|python3|perl</match>
    <description>MITRE T1059 - Command Interpreter: Script execution detected</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Ransomware Extension -->
  <rule id="100006" level="12">
    <if_sid>554</if_sid>
    <field name="file">\.encrypted$|\.locked$|\.crypto$|\.ransom$</field>
    <description>MITRE T1486 - Ransomware extension detected</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- C2 Traffic -->
  <rule id="100007" level="10">
    <if_sid>86601</if_sid>
    <match>ET MALWARE|ET TROJAN|ET CNC</match>
    <description>MITRE T1071 - C2 Channel: Malicious traffic detected by Suricata</description>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <!-- Port Scanning -->
  <rule id="100008" level="8">
    <if_sid>86601</if_sid>
    <match>ET SCAN|NMAP|port scan</match>
    <description>MITRE T1046 - Network Service Scanning: Scan detected</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Privilege Escalation -->
  <rule id="100009" level="12">
    <if_matched_sid>5303</if_matched_sid>
    <description>MITRE T1548 - Privilege Escalation: Sudo abuse detected</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>

  <!-- User Creation -->
  <rule id="100010" level="10">
    <if_sid>5902</if_sid>
    <description>MITRE T1136 - Create Account: New user created</description>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>

  <!-- SSH Root Login -->
  <rule id="100011" level="12">
    <if_sid>5715</if_sid>
    <match>root</match>
    <description>SOC: Login SSH directo como root desde $(srcip)</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>authentication_success,privileged_access,</group>
  </rule>

  <!-- Modificacion sudoers -->
  <rule id="100022" level="12">
    <if_sid>550</if_sid>
    <field name="file">^/etc/sudoers$</field>
    <description>SOC: Modificacion de /etc/sudoers - posible escalada privilegios</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>fim,privilege_escalation,</group>
  </rule>

  <!-- Reverse Shell -->
  <rule id="100030" level="14">
    <if_sid>530</if_sid>
    <match>nc -e|ncat -e|bash -i|/dev/tcp|/dev/udp</match>
    <description>SOC: Posible reverse shell detectado</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>reverse_shell,execution,</group>
  </rule>

  <!-- Correlación brute force -->
  <rule id="100050" level="12" timeframe="60" frequency="5">
    <if_matched_sid>100001</if_matched_sid>
    <description>Correlación: Brute Force repetido - posible ataque sostenido T1110</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Wazuh Agent Disconnect -->
  <rule id="100400" level="12">
    <if_sid>504</if_sid>
    <description>Wazuh agent disconnected — SOC monitoring gap</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>


<!-- ========================================================= -->
<!-- SYSHECK / FIM -->
<!-- ========================================================= -->


  <!-- Cambio archivo crítico -->
  <rule id="100100" level="12">
    <if_sid>550</if_sid>
    <description>FIM: Cambio en archivo critico del sistema</description>
    <mitre>
      <id>T1565</id>
    </mitre>
  </rule>

  <rule id="100101" level="12">
    <if_sid>5902</if_sid>
    <description>FIM: Nuevo usuario creado en el sistema - posible persistencia</description>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>

  <!-- sudoers -->
  <rule id="100102" level="12">
    <if_sid>550</if_sid>
    <field name="file">^/etc/sudoers$</field>
    <description>FIM: Modificacion de sudoers - posible escalada de privilegios</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>

  <!-- systemd persistence -->
  <rule id="100103" level="12">
    <if_sid>554</if_sid>
    <field name="file">^/etc/systemd/system</field>
    <description>FIM: Nuevo servicio systemd creado - posible persistencia</description>
    <mitre>
      <id>T1543</id>
    </mitre>
  </rule>

<!-- ========================================================= -->
  <!-- WINDOWS / SYSMON CUSTOM RULES -->
  <!-- ========================================================= -->

  <!-- PowerShell sospechoso — T1059.001 -->
  <rule id="100500" level="12">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(encodedcommand|bypass|hidden|iex|invoke-expression|downloadstring|webclient)</field>
    <description>MITRE T1059.001 - PowerShell sospechoso: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>windows,powershell,execution,</group>
  </rule>

  <!-- LSASS access — T1003.001 -->
  <rule id="100501" level="14">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <description>MITRE T1003.001 - Acceso a LSASS detectado - posible credential dumping</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>windows,credential_access,</group>
  </rule>

  <!-- Nuevo servicio creado — T1543.003 -->
  <rule id="100502" level="12">
    <if_sid>7040</if_sid>
    <field name="win.system.channel">System</field>
    <description>MITRE T1543.003 - Nuevo servicio Windows creado - posible persistencia</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <group>windows,persistence,</group>
  </rule>

  <!-- Modificacion registro Run keys — T1547.001 -->
  <rule id="100503" level="12">
    <if_sid>61614</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(\\CurrentVersion\\Run|\\CurrentVersion\\RunOnce)</field>
    <description>MITRE T1547.001 - Modificacion Run key registro - posible persistencia</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>windows,persistence,registry,</group>
  </rule>

  <!-- Creacion usuario local — T1136.001 -->
  <rule id="100504" level="12">
    <if_sid>60106</if_sid>
    <description>MITRE T1136.001 - Usuario local creado en Windows</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>windows,persistence,</group>
  </rule>

  <!-- Mimikatz por nombre proceso — T1003 -->
  <rule id="100505" level="15">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(mimikatz|mimilib|wce\.exe|pwdump)</field>
    <description>MITRE T1003 - Herramienta credential dumping detectada: $(win.eventdata.image)</description>
    <mitre>
      <id>T1003</id>
    </mitre>
    <group>windows,credential_access,</group>
  </rule>
</group>
